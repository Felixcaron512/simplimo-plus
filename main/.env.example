PORT=3000
# Obligatoire en production : openssl rand -hex 32
JWT_SECRET=5c55da1344780e5c740b12fb80144104dd3ae31700b3f3e5f6e59795c4f43c26
# Base de données : "sqlite" (Windows / test) ou "pg" (production)
DB_CLIENT=sqlite
SQLITE_FILE=./data/simplimo.db
PG_URL=postgres://simplimo:simplimo@localhost:5432/simplimo
UPLOAD_DIR=./data/uploads
# Compte local de secours (créé au premier démarrage)
ADMIN_USER=admin
ADMIN_PASSWORD=axeVU212010
# HTTPS direct (optionnel, nécessaire pour la caméra depuis un téléphone)
SSL_CERT=
SSL_KEY=
# LDAP (Active Directory / OpenLDAP / outpost LDAP authentik)
LDAP_ENABLED=false
LDAP_URL=ldap://10.0.0.10:389
LDAP_BIND_DN=cn=svc-simplimo,ou=services,dc=exemple,dc=net
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=dc=exemple,dc=net
# AD : (sAMAccountName={{u}})   OpenLDAP : (uid={{u}})
LDAP_USER_FILTER=(uid={{u}})
LDAP_TLS_REJECT_UNAUTHORIZED=true
# DN complets des groupes -> rôles (l'ordre de priorité est admin > manager > technician)
LDAP_GROUP_ADMIN=cn=simplimo-admin,ou=groups,dc=exemple,dc=net
LDAP_GROUP_MANAGER=cn=simplimo-manager,ou=groups,dc=exemple,dc=net
LDAP_GROUP_TECH=cn=simplimo-tech,ou=groups,dc=exemple,dc=net
